# Fibonacci 1: Simple loop (basic)
# Calculates the 6th Fibonacci number (8)
# Features: basic arithmetic, labels, conditional jumps

&r1 <- copy val/1    # current = 1
&r2 <- copy val/0    # previous = 0
&r3 <- copy val/6    # counter = 6

loop:
&r3 <- sub val/1     # decrement counter
&r3 <~ copy &r3      # set flags based on r3
pc <0 copy val/end   # if zero, jump to end

&r5 <- copy &r1      # temp = current
&r5 <- add &r2       # temp += previous
&r2 <- copy &r1      # previous = current
&r1 <- copy &r5      # current = temp

pc <- copy val/loop  # loop again

end:
pc <- copy pc/0      # halt
